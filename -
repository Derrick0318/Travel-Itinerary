/* My Trip — cinematic love-letter / postcard theme. System fonts only, no external assets. */

:root {
  --paper: #f3e8cc;
  --paper-2: #eadcb9;
  --card: #fffaf0;
  --card-2: #f8eed8;
  --ink: #1c2442;
  --ink-2: #4b5470;
  --line: rgba(28, 36, 66, .16);
  --red: #c0392b;
  --on-red: #fff;
  --gold: #c9993a;
  --gold-ink: #86610f;
  --gold-bg: rgba(201, 153, 58, .16);
  --cyan: #0b7f93;
  --cyan-bg: rgba(11, 127, 147, .10);
  --blue: #2a4a9a;
  --stamp-bg: #fffdf6;
  --foil: linear-gradient(135deg, #f8e3a0 0%, #d9a63f 38%, #f6dc8c 55%, #a97b22 100%);
  --foil-ink: #3a2705;
  --glass: rgba(255, 250, 240, .66);
  --glass-line: rgba(255, 255, 255, .6);
  --shadow: 0 1px 0 rgba(28, 36, 66, .06), 0 14px 30px -16px rgba(60, 40, 10, .5);
  --tex-fine: TEX_FINE;
  --tex-blot: TEX_BLOT;
  --glow: radial-gradient(ellipse 80% 40% at 50% -5%, rgba(255, 244, 214, .9), transparent 70%), radial-gradient(ellipse 120% 80% at 50% 120%, rgba(150, 100, 30, .16), transparent 60%);
  --hdr: 56px;
  --tab: 60px;
  --safe-b: env(safe-area-inset-bottom, 0px);
  --serif: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", serif;
  --sans: system-ui, -apple-system, "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  --airmail: repeating-linear-gradient(-45deg, var(--red) 0 12px, var(--card) 12px 20px, var(--blue) 20px 32px, var(--card) 32px 40px);
  --ease: cubic-bezier(.2, .7, .2, 1);
  --spring: cubic-bezier(.34, 1.7, .5, 1);
  color-scheme: light;
}

@media (prefers-color-scheme: dark) {
  :root {
    --paper: #0d1126;
    --paper-2: #161b36;
    --card: #1a2040;
    --card-2: #20274b;
    --ink: #f2e9d3;
    --ink-2: #bdb9ac;
    --line: rgba(242, 233, 211, .18);
    --red: #ff7a68;
    --on-red: #2a0d0a;
    --gold: #e3b559;
    --gold-ink: #e8c277;
    --gold-bg: rgba(227, 181, 89, .14);
    --cyan: #5fd6e6;
    --cyan-bg: rgba(95, 214, 230, .10);
    --blue: #6f8ee8;
    --stamp-bg: #232a52;
    --foil: linear-gradient(135deg, #fff0b8 0%, #e3b559 38%, #ffe69a 55%, #b88a2e 100%);
    --glass: rgba(24, 30, 62, .62);
    --glass-line: rgba(255, 255, 255, .14);
    --tex-fine: TEX_FINE_DARK;
    --tex-blot: none;
    --glow: radial-gradient(ellipse 70% 38% at 85% -5%, rgba(227, 181, 89, .2), transparent 70%), radial-gradient(ellipse 60% 40% at 0% 30%, rgba(95, 214, 230, .07), transparent 70%), radial-gradient(ellipse 100% 60% at 50% 110%, rgba(255, 122, 104, .08), transparent 60%);
    --shadow: 0 1px 0 rgba(0, 0, 0, .3), 0 16px 32px -16px rgba(0, 0, 0, .85);
    color-scheme: dark;
  }
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-padding-top: calc(var(--hdr) + 8px); }
@media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }

body {
  margin: 0; position: relative;
  font-family: var(--sans); font-size: 16px; line-height: 1.55; color: var(--ink);
  background-color: var(--paper);
  padding-bottom: calc(var(--tab) + 24px + var(--safe-b));
  overflow-x: hidden;
  -webkit-tap-highlight-color: transparent;
}
/* paper / ink-night backdrop (fixed layer = cheap to scroll) */
body::before {
  content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background-image: var(--glow), var(--tex-blot), var(--tex-fine);
  background-size: 100% 100%, 600px 600px, 240px 240px;
}
:lang(zh) { line-height: 1.7; }

img, svg { max-width: 100%; display: block; }
button { font: inherit; color: inherit; cursor: pointer; }
a { color: inherit; }
h1, h2, h3, h4 { font-family: var(--serif); margin: 0; line-height: 1.2; }
p { margin: 0; }
ul, ol { margin: 0; padding: 0; list-style: none; }
:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; border-radius: 6px; }

.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.skip { position: absolute; left: 8px; top: -60px; z-index: 100; background: var(--ink); color: var(--paper); padding: 10px 14px; border-radius: 8px; }
.skip:focus { top: 8px; }
.wrap { width: 100%; max-width: 1040px; margin: 0 auto; padding: 0 16px; }

/* ---------- top bar + travelling plane ---------- */
.topbar {
  position: sticky; top: 0; z-index: 50;
  background: color-mix(in srgb, var(--paper) 80%, transparent);
  -webkit-backdrop-filter: blur(14px) saturate(1.4); backdrop-filter: blur(14px) saturate(1.4);
  padding-top: env(safe-area-inset-top, 0px);
}
.topbar-in { max-width: 1040px; margin: 0 auto; height: var(--hdr); padding: 0 12px 0 16px; display: flex; align-items: center; gap: 12px; }
.trail { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; pointer-events: none; }
.trail .base, .trail .fill { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 11px); }
.trail .fill { background: repeating-linear-gradient(90deg, var(--red) 0 6px, transparent 6px 11px); clip-path: inset(0 100% 0 0); }
.trail .plane { position: absolute; left: 0; top: -8px; font-size: 16px; line-height: 1; color: var(--red); transform: translate3d(0, 0, 0) rotate(45deg); will-change: transform; filter: drop-shadow(0 1px 1px rgba(0, 0, 0, .3)); }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; min-height: 44px; margin-right: auto; }
.brand-mark {
  width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center;
  font-family: var(--serif); font-weight: 700; font-size: 18px; color: var(--red);
  border: 2px double var(--red); transform: rotate(-8deg);
}
.brand-text { display: flex; flex-direction: column; line-height: 1.15; }
.brand-text b { font-family: var(--serif); font-size: 16px; }
.brand-text small { font-size: 11px; color: var(--ink-2); }
.topnav { display: none; }
.lang { display: inline-flex; border: 1.5px solid var(--ink); border-radius: 999px; overflow: hidden; }
.lang button { min-width: 48px; min-height: 40px; border: 0; background: transparent; font-weight: 700; font-size: 14px; transition: background .2s, color .2s; }
.lang button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }

/* ---------- glass floating tab bar (phone) ---------- */
.tabbar {
  position: fixed; left: 10px; right: 10px; bottom: calc(8px + var(--safe-b)); z-index: 60; --i: 0;
  display: grid; grid-template-columns: repeat(4, 1fr);
  background: var(--glass); border: 1px solid var(--glass-line); border-radius: 22px; overflow: hidden;
  -webkit-backdrop-filter: blur(20px) saturate(1.7); backdrop-filter: blur(20px) saturate(1.7);
  box-shadow: 0 10px 30px -8px rgba(20, 15, 5, .45), inset 0 1px 0 rgba(255, 255, 255, .35);
  max-width: 520px; margin: 0 auto;
}
.tab-ind { position: absolute; top: 0; left: 0; width: 25%; height: 100%; display: grid; place-items: start center; transform: translateX(calc(var(--i) * 100%)); transition: transform .55s var(--spring), opacity .25s; pointer-events: none; }
.tab-ind::before { content: ""; width: 30px; height: 3px; border-radius: 0 0 4px 4px; background: var(--red); box-shadow: 0 0 12px var(--red); }
.tab-ind::after { content: ""; position: absolute; inset: 6px 8px; border-radius: 16px; background: color-mix(in srgb, var(--red) 12%, transparent); }
.tabbar[data-none="true"] .tab-ind { opacity: 0; }
.tabbar a {
  position: relative; z-index: 1; min-height: var(--tab); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px;
  text-decoration: none; font-size: 12px; font-weight: 700; color: var(--ink-2); transition: color .2s;
}
.tabbar .ti { font-size: 21px; line-height: 1.1; filter: grayscale(.7); transition: transform .4s var(--spring), filter .2s; }
.tabbar a[aria-current="true"] { color: var(--red); }
.tabbar a[aria-current="true"] .ti { filter: none; transform: translateY(-2px) scale(1.18); }

/* ---------- cinematic hero ---------- */
.hero {
  position: relative; isolation: isolate; overflow: hidden; color: #fff7e6; display: flex; align-items: flex-end;
  min-height: calc(100vh - var(--hdr)); min-height: calc(100svh - var(--hdr));
  background: #0d1126;
}
.hero > .ph { position: absolute; inset: 0; z-index: -4; aspect-ratio: auto; border-radius: 0; }
.hero > .ph img { transform-origin: 62% 42%; animation: kb 28s ease-in-out infinite alternate; will-change: transform; }
@keyframes kb { from { transform: scale(1.04) translate3d(0, 0, 0); } to { transform: scale(1.22) translate3d(-2.5%, -2%, 0); } }
.hero-shade {
  position: absolute; inset: 0; z-index: -3;
  background:
    radial-gradient(130% 70% at 15% 105%, rgba(192, 57, 43, .45), transparent 60%),
    linear-gradient(180deg, rgba(10, 12, 30, .55) 0%, rgba(10, 12, 30, .08) 26%, rgba(10, 12, 30, .3) 52%, rgba(10, 12, 30, .93) 100%),
    radial-gradient(120% 90% at 50% 40%, transparent 45%, rgba(5, 6, 18, .55) 100%);
}
.grain { position: absolute; inset: -50%; z-index: -2; pointer-events: none; background-image: GRAIN; background-size: 180px 180px; opacity: .22; mix-blend-mode: overlay; animation: grain 1.2s steps(6) infinite; }
@keyframes grain { 0% { transform: translate(0, 0); } 20% { transform: translate(-3%, 2%); } 40% { transform: translate(2%, -3%); } 60% { transform: translate(-2%, -1%); } 80% { transform: translate(3%, 3%); } 100% { transform: translate(0, 0); } }
.hero-vert {
  position: absolute; z-index: -1; right: max(8px, 3vw); top: 16px; pointer-events: none; user-select: none;
  writing-mode: vertical-rl; font-family: var(--serif); font-weight: 900; line-height: 1.04; letter-spacing: .02em;
  font-size: min(15vw, 8.6svh, 124px); color: rgba(255, 226, 160, .2);
  text-shadow: 0 0 46px rgba(227, 181, 89, .35), 0 0 2px rgba(255, 226, 160, .5);
}
.hero-vert .ch { display: inline-block; }
.hero-in { width: 100%; max-width: 1040px; margin: 0 auto; padding: 0 20px 104px; position: relative; }
.kicker { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; opacity: .92; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; animation: fadeUp .9s var(--ease) .1s both; }
.kicker::before { content: ""; width: 30px; height: 1.5px; background: var(--gold); }
.hero h1 { font-size: clamp(36px, 10.5vw, 72px); font-weight: 900; letter-spacing: .01em; line-height: 1.08; text-shadow: 0 2px 22px rgba(0, 0, 0, .55); }
.hero h1 .w { display: inline-block; white-space: nowrap; }
.hero .ch { display: inline-block; animation: chIn .9s var(--ease) both; animation-delay: calc(.25s + var(--i) * 48ms); }
.hero-vert .ch { animation-delay: calc(.5s + var(--i) * 130ms); animation-duration: 1.3s; }
@keyframes chIn { from { opacity: 0; transform: translate3d(0, .55em, 0) rotate(5deg) scale(.9); } to { opacity: 1; transform: none; } }
@keyframes fadeUp { from { opacity: 0; transform: translate3d(0, 14px, 0); } to { opacity: 1; transform: none; } }
.hero .sub { margin-top: 14px; font-family: var(--serif); font-style: italic; font-size: clamp(15px, 4vw, 19px); max-width: 34ch; opacity: .96; text-shadow: 0 1px 8px rgba(0, 0, 0, .7); animation: fadeUp 1s var(--ease) .9s both; }
.hero .dur { margin-top: 18px; display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid var(--gold); color: #ffe6ae; border-radius: 4px; padding: 5px 13px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; font-weight: 800; background: rgba(16, 20, 42, .4); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: fadeUp 1s var(--ease) 1.1s both; }
.hero .airmail { position: absolute; left: 0; right: 0; bottom: 0; }
.airmail { height: 10px; background: var(--airmail); }
.hero-credit { position: absolute; left: 20px; bottom: 46px; font-size: 10px; opacity: .7; }
.noanim .ch, .noanim .kicker, .noanim .sub, .noanim .dur, .noanim .seal, .noanim .hero > .ph img { animation: none; }
.seal {
  position: absolute; right: 20px; bottom: 78px; width: 76px; height: 76px; display: grid; place-items: center;
  border-radius: 46% 54% 50% 50% / 52% 46% 54% 48%;
  background: radial-gradient(circle at 34% 28%, #e8664f, #b32f22 55%, #7a1810);
  color: rgba(255, 224, 205, .92); font-family: var(--serif); font-weight: 900; font-size: 36px; text-shadow: 0 -1px 0 rgba(0, 0, 0, .4), 0 1px 0 rgba(255, 255, 255, .25);
  box-shadow: 0 8px 16px rgba(0, 0, 0, .55), inset 0 2px 3px rgba(255, 255, 255, .4), inset 0 -4px 8px rgba(0, 0, 0, .45);
  transform: rotate(-12deg); animation: seal 1.1s cubic-bezier(.2, 1.3, .4, 1) 1.5s both;
}
.seal::before { content: ""; position: absolute; inset: 8px; border: 2px solid rgba(255, 224, 205, .5); border-radius: inherit; }
.seal::after { content: ""; position: absolute; inset: 0; border-radius: inherit; border: 2px solid rgba(255, 150, 120, .8); animation: ripple .8s ease-out 2.05s both; }
@keyframes seal { 0% { opacity: 0; transform: translate3d(0, -70px, 0) scale(2.4) rotate(-40deg); } 50% { opacity: 1; transform: translate3d(0, 0, 0) scale(.86) rotate(-12deg); } 72% { transform: scale(1.07) rotate(-12deg); } 100% { opacity: 1; transform: rotate(-12deg); } }
@keyframes ripple { from { opacity: .9; transform: scale(1); } to { opacity: 0; transform: scale(1.9); } }
.scroll-cue { position: absolute; left: 50%; bottom: 44px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 10px; letter-spacing: .3em; text-transform: uppercase; opacity: .85; pointer-events: none; text-indent: .3em; }
.scroll-cue i { display: block; width: 1.5px; height: 26px; background: linear-gradient(var(--gold), transparent); transform-origin: top; animation: cue 1.9s ease-in-out infinite; }
@keyframes cue { 0% { transform: scaleY(0); opacity: 1; } 55% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }

/* countdown "postcard" */
.cd-wrap { max-width: 1040px; margin: -34px auto 0; padding: 0 16px; position: relative; z-index: 2; }
.cd {
  display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: center;
  background: var(--card); border-radius: 8px; padding: 16px; box-shadow: var(--shadow); border: 1px solid var(--line); position: relative;
}
.cd::after { content: ""; position: absolute; inset: 5px; border: 1px dashed var(--line); border-radius: 4px; pointer-events: none; }
.postmark {
  position: relative; width: 92px; height: 92px; border-radius: 50%; display: grid; place-items: center; text-align: center;
  color: var(--red); border: 3px double var(--red); transform: rotate(-9deg); line-height: 1; font-family: var(--serif);
}
.postmark::before { content: ""; position: absolute; inset: 5px; border: 1px solid var(--red); border-radius: 50%; opacity: .6; }
.postmark b { display: block; font-size: 34px; font-weight: 800; }
.postmark small { display: block; font-size: 10px; letter-spacing: .16em; font-family: var(--sans); font-weight: 700; margin-top: 3px; text-transform: uppercase; }
.postmark .em { font-size: 34px; }
.postmark::after { display: none; content: ""; position: absolute; left: 82%; top: 38%; width: 64px; height: 22px; transform: rotate(-9deg); background: repeating-linear-gradient(180deg, var(--red) 0 2px, transparent 2px 7px); opacity: .55; -webkit-mask: linear-gradient(90deg, #000 70%, transparent); mask: linear-gradient(90deg, #000 70%, transparent); }
.cd-text { min-width: 0; }
.cd-title { font-family: var(--serif); font-size: 22px; font-weight: 800; line-height: 1.2; }
.cd-sub { color: var(--ink-2); font-size: 14px; margin-top: 2px; }
.cd-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.cd form { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; align-items: center; }
.cd input[type="date"] { min-height: 44px; padding: 0 10px; border: 1.5px solid var(--ink); border-radius: 8px; background: var(--paper); color: var(--ink); font: inherit; max-width: 100%; }
.flips { display: flex; gap: 8px; margin-top: 12px; perspective: 400px; }
.fu { text-align: center; }
.fcard {
  position: relative; min-width: 52px; padding: 9px 6px; border-radius: 8px; overflow: hidden;
  background: linear-gradient(180deg, #2b3260 0 50%, #222850 50%); color: #fbf1d6;
  font-family: var(--serif); font-weight: 800; font-size: 27px; line-height: 1; font-variant-numeric: tabular-nums;
  box-shadow: 0 4px 10px rgba(0, 0, 0, .3), inset 0 0 0 1px rgba(227, 181, 89, .3);
}
.fcard::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgba(0, 0, 0, .6); box-shadow: 0 1px 0 rgba(255, 255, 255, .08); }
.fnum { display: block; transform-origin: 50% 0; }
.fcard.tick .fnum { animation: flip .55s var(--ease); }
@keyframes flip { from { transform: rotateX(-95deg); opacity: .2; } to { transform: none; opacity: 1; } }
.fu small { display: block; margin-top: 5px; font-size: 10px; letter-spacing: .14em; color: var(--ink-2); font-weight: 800; text-transform: uppercase; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 0 16px;
  border-radius: 999px; border: 1.5px solid var(--ink); background: transparent; color: var(--ink); font-weight: 700; font-size: 14px; text-decoration: none;
  transition: transform .15s var(--ease), background .15s;
}
.btn:active { transform: scale(.95); }
.btn.primary { background: var(--red); border-color: var(--red); color: var(--on-red); box-shadow: 0 6px 14px -6px var(--red); }
.btn.ghost { border-color: var(--line); color: var(--ink-2); }

/* ---------- sections & headers ---------- */
.sec { padding: 44px 0 8px; position: relative; }
.sec:not(#days)::before { content: ""; display: block; height: 8px; background: var(--airmail); opacity: .9; margin-bottom: 34px; }
.sec-head { margin: 22px 0 18px; text-align: center; }
.sh-small { font-family: var(--serif); font-weight: 900; font-size: 13px; letter-spacing: .5em; text-indent: .5em; color: var(--red); text-transform: uppercase; }
:lang(en) .sh-small[lang="en"], .sh-small.up { letter-spacing: .3em; font-family: var(--sans); font-size: 11px; font-weight: 800; }
.sec-head h2 { font-size: clamp(30px, 8vw, 44px); margin-top: 6px; font-weight: 900; letter-spacing: .01em; }
.sec-head .lede { color: var(--ink-2); margin: 8px auto 0; max-width: 50ch; font-size: 15px; }
.orn { display: block; margin: 12px auto 0; width: 210px; height: 24px; color: var(--gold); }
.orn path, .orn circle { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
.orn .fillc { fill: currentColor; stroke: none; }

.js .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
.js .reveal.in { opacity: 1; transform: none; }

/* ---------- photos ---------- */
.ph {
  position: relative; overflow: hidden; margin: 0; aspect-ratio: 16 / 9; border-radius: 10px;
  background: linear-gradient(135deg, color-mix(in srgb, var(--red) 30%, var(--paper-2)), color-mix(in srgb, var(--blue) 35%, var(--paper-2)));
}
.ph-fb { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; text-align: center; padding: 10px; color: var(--ink); font-family: var(--serif); font-size: 14px; opacity: .85; }
.ph-fb .e { font-size: 40px; line-height: 1; }
.ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.ph.failed img { display: none; }
.ph .credit { position: absolute; right: 6px; bottom: 6px; max-width: calc(100% - 12px); font-size: 10px; line-height: 1.3; padding: 2px 7px; border-radius: 99px; background: rgba(16, 20, 42, .62); color: #f6eedd; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
@media (prefers-color-scheme: dark) { .ph img { filter: brightness(.92) contrast(1.03); } }

/* ---------- stamp shape (perforated edge) ---------- */
.stamp-wrap { display: inline-block; filter: drop-shadow(0 2px 2px rgba(28, 36, 66, .35)); }
.stamp {
  --hole: 3.4px; --pitch: 10px;
  position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden;
  background: var(--stamp-bg); color: var(--acc, var(--red)); padding: 10px 4px;
  -webkit-mask-image: radial-gradient(circle var(--hole) at 50% 0, #0000 98%, #000 100%), radial-gradient(circle var(--hole) at 50% 100%, #0000 98%, #000 100%), radial-gradient(circle var(--hole) at 0 50%, #0000 98%, #000 100%), radial-gradient(circle var(--hole) at 100% 50%, #0000 98%, #000 100%);
  -webkit-mask-size: var(--pitch) 100%, var(--pitch) 100%, 100% var(--pitch), 100% var(--pitch);
  -webkit-mask-repeat: round no-repeat, round no-repeat, no-repeat round, no-repeat round;
  -webkit-mask-composite: source-in;
  mask-image: radial-gradient(circle var(--hole) at 50% 0, #0000 98%, #000 100%), radial-gradient(circle var(--hole) at 50% 100%, #0000 98%, #000 100%), radial-gradient(circle var(--hole) at 0 50%, #0000 98%, #000 100%), radial-gradient(circle var(--hole) at 100% 50%, #0000 98%, #000 100%);
  mask-size: var(--pitch) 100%, var(--pitch) 100%, 100% var(--pitch), 100% var(--pitch);
  mask-repeat: round no-repeat, round no-repeat, no-repeat round, no-repeat round;
  mask-composite: intersect;
}
.stamp::after { content: ""; position: absolute; inset: 6px; border: 1px solid currentColor; opacity: .35; pointer-events: none; }
.stamp small { font-size: 9px; letter-spacing: .22em; font-weight: 800; text-indent: .22em; }
.stamp b { font-family: var(--serif); font-size: 26px; font-weight: 900; line-height: 1.05; }
.foil .stamp { background: var(--foil); color: var(--foil-ink); }
.foil .stamp::before { content: ""; position: absolute; top: -20%; bottom: -20%; left: 0; width: 60%; background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, .85) 50%, transparent 80%); transform: translateX(-160%) skewX(-12deg); animation: shine 5s ease-in-out infinite; mix-blend-mode: soft-light; }
.foil .stamp::after { opacity: .5; }
@keyframes shine { 0%, 55% { transform: translateX(-160%) skewX(-12deg); } 85%, 100% { transform: translateX(300%) skewX(-12deg); } }

/* ---------- day chips ---------- */
.chips-bar {
  position: sticky; top: calc(var(--hdr) + env(safe-area-inset-top, 0px)); z-index: 40;
  background: color-mix(in srgb, var(--paper) 78%, transparent);
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
  margin: 0 0 16px;
}
.chips { position: relative; display: flex; gap: 8px; overflow-x: auto; padding: 12px 4px 12px; scroll-snap-type: x proximity; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.chips::-webkit-scrollbar { display: none; }
.chip { flex: 0 0 auto; border: 0; background: transparent; padding: 2px; scroll-snap-align: center; border-radius: 4px; position: relative; transition: transform .55s var(--spring); }
.chip .stamp { width: 50px; height: 58px; padding: 6px 2px; }
.chip .stamp b { font-size: 21px; }
.chip[data-vibe="future"] .stamp { --acc: var(--cyan); }
.chip[data-vibe="film"] .stamp { --acc: var(--gold-ink); }
.chip[data-vibe="city"] .stamp { --acc: var(--blue); }
.chip[aria-current="true"] { transform: translateY(-4px) rotate(-4deg) scale(1.22); z-index: 2; }
.chip[aria-current="true"] .stamp { background: var(--acc, var(--red)); color: var(--on-red); }
.chip[aria-current="true"] .stamp-wrap { filter: drop-shadow(0 6px 6px rgba(28, 36, 66, .4)); }
.chip[data-vibe="future"][aria-current="true"] .stamp { color: #04222a; }
.chip.today::before { content: ""; position: absolute; top: -1px; right: -1px; width: 12px; height: 12px; border-radius: 50%; background: var(--gold); border: 2px solid var(--paper); z-index: 3; animation: pulseDot 2s ease-out infinite; }
@keyframes pulseDot { 0% { box-shadow: 0 0 0 0 rgba(227, 181, 89, .7); } 100% { box-shadow: 0 0 0 9px rgba(227, 181, 89, 0); } }

/* ---------- day postcards ---------- */
.day-list { display: grid; gap: 34px; }
.day {
  --acc: var(--red); --foil-ink: #3a2705;
  position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow);
  scroll-margin-top: 82px; min-width: 0; overflow: clip;
}
.day[data-vibe="future"] { --acc: var(--cyan); --foil: linear-gradient(135deg, #d4f8ff 0%, #4cbdd2 38%, #bff1fa 55%, #1b8aa0 100%); --foil-ink: #03242c; }
.day[data-vibe="film"] { --acc: var(--gold-ink); }
.day[data-vibe="city"] { --acc: var(--blue); }
.day.today { outline: 2.5px solid var(--gold); outline-offset: 3px; }
.day-left { min-width: 0; }
.day-media { position: relative; transform-style: preserve-3d; transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .3s ease-out; }
.day-media > .ph { border-radius: 0; aspect-ratio: 4 / 4.1; }
.day-media > .ph img { transform: translate3d(0, var(--py, 0px), 0) scale(1.16); will-change: transform; }
.day-media > .ph .credit { top: 10px; bottom: auto; }
.day-media::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(8, 10, 24, .38) 0%, transparent 30%, rgba(8, 10, 24, .15) 50%, rgba(8, 10, 24, .92) 100%); }
.day-media .stamp-wrap { position: absolute; left: 16px; top: 14px; z-index: 3; transform: rotate(-6deg) translateZ(30px); }
.day-media .stamp { width: 62px; height: 74px; }
.day-media .stamp b { font-size: 31px; }
.today-flag { position: absolute; left: 92px; top: 20px; z-index: 3; background: var(--gold); color: #2a1d00; font-weight: 800; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; transform: rotate(3deg); box-shadow: 0 2px 6px rgba(0, 0, 0, .35); }
.day-over { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 0 18px 18px; color: #fff7e6; transform: translateZ(20px); }
.day-over .vibe { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; font-weight: 800; color: #ffd98a; text-shadow: 0 1px 6px rgba(0, 0, 0, .6); }
.day[data-vibe="future"] .day-over .vibe { color: #8eeaf7; }
.day-over h3 { font-size: clamp(24px, 6.8vw, 32px); margin-top: 4px; font-weight: 900; text-shadow: 0 2px 14px rgba(0, 0, 0, .6); text-wrap: balance; }
.day-over .drive { margin-top: 6px; font-size: 14px; opacity: .92; display: flex; gap: 6px; align-items: baseline; text-shadow: 0 1px 6px rgba(0, 0, 0, .6); }
.tagline { margin: 16px 18px 0; font-family: var(--serif); font-style: italic; font-size: 18px; line-height: 1.45; padding-left: 14px; border-left: 3px solid var(--acc); position: relative; }
.day-main { padding: 18px 16px 20px; display: grid; gap: 18px; min-width: 0; }
.day > .airmail { grid-column: 1 / -1; height: 6px; }

.meals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.meal { border-radius: 10px; padding: 8px 6px; text-align: center; font-size: 12px; line-height: 1.25; border: 1.5px solid var(--line); background: var(--card-2); min-width: 0; }
.meal .mi { font-size: 20px; display: block; line-height: 1.2; }
.meal .mn { display: block; font-weight: 700; margin-top: 2px; }
.meal .ms { display: block; color: var(--ink-2); font-size: 11.5px; overflow-wrap: anywhere; }
.meal.in { border-color: var(--acc); background: color-mix(in srgb, var(--acc) 10%, var(--card)); }
.meal.in .ms { color: var(--acc); font-weight: 700; }
.meal.own { border-style: dashed; border-color: var(--gold); background: var(--gold-bg); }
.meal.own .ms { color: var(--gold-ink); font-weight: 700; }
.meal.air { border-style: dotted; border-width: 2px; border-color: var(--blue); background: color-mix(in srgb, var(--blue) 10%, var(--card)); }
.meal.air .ms { color: var(--blue); font-weight: 700; }
.meal.none { opacity: .55; }
.meal-note { font-size: 14px; padding: 8px 12px; background: var(--card-2); border-radius: 8px; margin-top: -6px; }

.sub-h { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; font-weight: 800; color: var(--ink-2); margin-bottom: 10px; }
.timeline { position: relative; display: grid; gap: 16px; }
.timeline::before { content: ""; position: absolute; left: 17px; top: 12px; bottom: 12px; border-left: 2px dashed var(--line); }
.stop { position: relative; display: grid; grid-template-columns: 36px 1fr; gap: 10px; min-width: 0; }
.stop .node { z-index: 1; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-size: 17px; background: var(--card); border: 2px solid var(--acc); }
.stop-body { min-width: 0; padding-top: 2px; position: relative; }
.stop-head { display: grid; grid-template-columns: 1fr 44px; gap: 6px; align-items: start; }
.stop-t { min-width: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; }
.stop h4 { font-size: 17px; }
.tagpill { font-size: 11px; font-weight: 700; padding: 1px 8px; border-radius: 99px; background: var(--card-2); color: var(--ink-2); border: 1px solid var(--line); white-space: nowrap; }
.stop p { color: var(--ink-2); font-size: 14.5px; margin-top: 2px; }
.stop .ph { margin-top: 8px; aspect-ratio: 16 / 9; }
.pin { width: 44px; height: 44px; margin: -6px -4px 0 0; border-radius: 50%; border: 1.5px solid var(--line); background: var(--card); display: grid; place-items: center; font-size: 18px; transition: transform .3s var(--spring), background .2s; }
.pin:active { transform: scale(.88); }
.pin:hover { background: var(--card-2); }

/* film-location stops */
.stop.film .node { background: var(--gold); border-color: var(--gold-ink); box-shadow: 0 0 0 4px var(--gold-bg); }
.stop.film .stop-body {
  background: linear-gradient(180deg, color-mix(in srgb, var(--gold) 20%, transparent), var(--gold-bg));
  border-radius: 8px; padding: 14px 8px 12px 24px; margin-top: 6px;
  border: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
}
.stop.film .stop-body::before { content: ""; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 8px; background: radial-gradient(circle 2.3px at 50% 50%, var(--gold-ink) 98%, transparent 100%) 0 0 / 8px 14px repeat-y; opacity: .6; }
.ribbon { position: absolute; top: -11px; left: 20px; z-index: 3; background: var(--gold); color: #2a1d00; font-size: 11px; font-weight: 800; letter-spacing: .06em; padding: 3px 10px; border-radius: 3px; box-shadow: 0 3px 6px rgba(0, 0, 0, .3); white-space: nowrap; }
.ribbon b { font-family: var(--serif); letter-spacing: .12em; margin-right: 4px; }
.stop.film .ph { filter: sepia(.38) saturate(1.1) contrast(1.06); border-radius: 4px; border: 5px solid #1a1410; border-top-width: 14px; border-bottom-width: 14px; }
.stop.film .ph::before, .stop.film .ph::after { content: ""; position: absolute; left: 0; right: 0; height: 14px; z-index: 3; background: repeating-linear-gradient(90deg, transparent 0 6px, rgba(245, 236, 216, .85) 6px 11px, transparent 11px 17px) 0 50% / 100% 6px no-repeat; }
.stop.film .ph::before { top: -14px; }
.stop.film .ph::after { bottom: -14px; }
.stop.film .ph .credit { bottom: 4px; }

/* optional tour callout */
.opt { border: 2px dashed var(--gold); background: var(--gold-bg); border-radius: 12px; padding: 12px 14px; position: relative; }
.opt .opt-tag { display: inline-block; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; font-weight: 800; color: var(--gold-ink); }
.opt h4 { font-size: 17px; margin-top: 3px; }
.opt .price { font-family: var(--serif); font-weight: 800; font-size: 20px; color: var(--gold-ink); margin-top: 4px; }
.opt .opt-note { font-size: 13.5px; color: var(--ink-2); margin-top: 2px; }
.check-btn { margin-top: 10px; }
.opt[data-on="true"] { border-style: solid; }
.hotel { display: flex; gap: 10px; align-items: center; padding: 12px 14px; border-radius: 12px; background: var(--card-2); border: 1px solid var(--line); font-size: 15px; }
.hotel .hi { font-size: 22px; }
.hotel small { display: block; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); font-weight: 700; }

/* ---------- map bottom sheet ---------- */
.sheet-root { position: fixed; inset: 0; z-index: 90; visibility: hidden; transition: visibility 0s .4s; }
.sheet-root.open { visibility: visible; transition-delay: 0s; }
.sheet-bg { position: absolute; inset: 0; background: rgba(8, 10, 24, .55); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); opacity: 0; transition: opacity .3s; }
.sheet {
  position: absolute; left: 0; right: 0; bottom: 0; margin: 0 auto; max-width: 560px;
  background: var(--card); border-radius: 22px 22px 0 0; padding: 10px 18px calc(20px + var(--safe-b));
  transform: translate3d(0, 100%, 0); transition: transform .45s var(--ease); box-shadow: 0 -14px 44px rgba(0, 0, 0, .45);
  border: 1px solid var(--line); border-bottom: 0;
}
.sheet-root.open .sheet-bg { opacity: 1; }
.sheet-root.open .sheet { transform: none; }
.sheet .grab { width: 44px; height: 4px; border-radius: 4px; background: var(--line); margin: 0 auto 14px; }
.sheet .sh-tag { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; font-weight: 800; color: var(--red); }
.sheet h3 { font-size: 22px; margin-top: 2px; }
.sheet .sh-desc { color: var(--ink-2); font-size: 14.5px; margin-top: 4px; }
.sheet .rows { display: grid; gap: 10px; margin-top: 16px; }
.sheet .rows a { display: grid; grid-template-columns: 34px 1fr auto; gap: 10px; align-items: center; min-height: 58px; padding: 8px 14px; border-radius: 14px; background: var(--card-2); border: 1px solid var(--line); text-decoration: none; font-weight: 800; }
.sheet .rows a small { display: block; font-weight: 500; font-size: 12px; color: var(--ink-2); }
.sheet .rows a .ic { font-size: 22px; }
.sheet .rows a:active { transform: scale(.98); }
.sheet .close { margin-top: 14px; width: 100%; }

/* ---------- flights ---------- */
.passes { display: grid; gap: 18px; margin: 4px 0 20px; }
.pass-wrap { filter: drop-shadow(0 10px 14px rgba(28, 36, 66, .22)); }
.pass {
  background: var(--card); border-radius: 14px; overflow: hidden; position: relative;
  -webkit-mask-image: radial-gradient(circle 10px at 0 calc(100% - 64px), #0000 98%, #000 100%), radial-gradient(circle 10px at 100% calc(100% - 64px), #0000 98%, #000 100%);
  -webkit-mask-composite: source-in;
  mask-image: radial-gradient(circle 10px at 0 calc(100% - 64px), #0000 98%, #000 100%), radial-gradient(circle 10px at 100% calc(100% - 64px), #0000 98%, #000 100%);
  mask-composite: intersect;
}
.pass .airmail { height: 8px; }
.pass-main { padding: 14px 18px 16px; }
.pass-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
.pass-top .airline { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 800; color: var(--ink-2); }
.pass-top .fno { font-family: var(--serif); font-weight: 800; font-size: 20px; color: var(--red); }
.pass-route { display: grid; grid-template-columns: 1fr auto 1fr; gap: 6px; align-items: center; margin-top: 12px; }
.pass-route .pt { min-width: 0; }
.pass-route .pt.r { text-align: right; }
.pass-route .code { font-family: var(--serif); font-size: 40px; font-weight: 900; line-height: 1; letter-spacing: .02em; display: block; }
.pass-route .cty { display: block; font-size: 13px; color: var(--ink-2); }
.pass-route time { display: block; font-weight: 800; font-size: 18px; margin-top: 2px; font-variant-numeric: tabular-nums; }
.pass-route .mid { display: flex; flex-direction: column; align-items: center; color: var(--ink-2); width: 56px; }
.pass-route .mid span { font-size: 22px; }
.pass-route .mid i { display: block; width: 100%; border-top: 2px dashed var(--line); margin-top: 4px; }
.pass-day { margin-top: 10px; display: inline-flex; }
.pass-stub { height: 64px; border-top: 2px dashed var(--line); padding: 0 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--card-2); }
.pass-stub .bag { font-size: 13.5px; font-weight: 600; display: flex; gap: 8px; align-items: center; min-width: 0; }
.pass-stub .bag small { display: block; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); }
.barcode { flex: 0 0 90px; height: 34px; opacity: .8; background: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 4px, var(--ink) 4px 5px, transparent 5px 8px, var(--ink) 8px 11px, transparent 11px 13px); }

/* ---------- map ---------- */
.map-card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 8px; box-shadow: var(--shadow); }
.map-svg { width: 100%; height: auto; }
.map-svg .grid { stroke: var(--ink); opacity: .08; stroke-width: 1; stroke-dasharray: 2 6; }
.map-svg .sea-t { font-family: var(--serif); font-style: italic; font-size: 13px; fill: var(--blue); opacity: .75; }
.map-svg .wave { fill: none; stroke: var(--blue); stroke-width: 1.6; stroke-linecap: round; opacity: .5; }
.map-svg .route { fill: none; stroke: var(--red); stroke-width: 3.2; stroke-linecap: round; stroke-dasharray: 7 8; }
.map-svg .mask-path { fill: none; stroke: #fff; stroke-width: 12; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
.map.in .mask-path { animation: draw 3.6s var(--ease) .2s forwards; }
.map.in .route { animation: march 1.4s linear infinite; }
.map-svg .rider { fill: var(--gold); stroke: var(--card); stroke-width: 2; filter: drop-shadow(0 0 4px var(--gold)); }
.map-svg .city { cursor: pointer; }
.map-svg .city .dot { fill: var(--red); stroke: var(--card); stroke-width: 2.5; transition: transform .3s var(--spring); transform-box: fill-box; transform-origin: center; }
.map-svg .city.future .dot { fill: var(--cyan); }
.map-svg .city.pass .dot { fill: var(--card); stroke: var(--red); stroke-width: 2.5; }
.map-svg .city:hover .dot, .map-svg .city:focus-visible .dot { transform: scale(1.25); }
.map-svg .city:focus-visible { outline: none; }
.map-svg .city:focus-visible .dot { stroke: var(--gold); stroke-width: 4; }
.map-svg .pulse { fill: none; stroke: var(--gold); stroke-width: 2.5; transform-box: fill-box; transform-origin: center; animation: pulse 1.8s ease-out infinite; pointer-events: none; }
.map-svg .num { font-family: var(--serif); font-weight: 800; font-size: 12px; fill: var(--on-red); text-anchor: middle; dominant-baseline: central; pointer-events: none; }
.map-svg .city.future .num { fill: #04222a; }
.map-svg .lab { font-family: var(--serif); font-weight: 700; font-size: 14px; fill: var(--ink); paint-order: stroke; stroke: var(--card); stroke-width: 4px; stroke-linejoin: round; pointer-events: none; }
.map-svg .compass { stroke: var(--ink); fill: none; opacity: .5; stroke-width: 1.4; }
.map-svg .compass text { fill: var(--ink); stroke: none; font-size: 11px; font-family: var(--serif); }
@keyframes draw { to { stroke-dashoffset: 0; } }
@keyframes march { to { stroke-dashoffset: -30; } }
@keyframes pulse { from { transform: scale(1); opacity: .95; } to { transform: scale(3); opacity: 0; } }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12.5px; color: var(--ink-2); padding: 6px 10px 4px; }
.legend i { display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: var(--red); vertical-align: -1px; margin-right: 5px; }
.legend i.p { background: var(--card); border: 2px solid var(--red); }
.legend i.f { background: var(--cyan); }
.legend i.t { background: var(--gold); }
.daylist { display: grid; gap: 8px; margin-top: 14px; }
.daylist button { display: grid; grid-template-columns: 34px 1fr auto; gap: 10px; align-items: center; text-align: left; min-height: 48px; padding: 6px 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--card); transition: transform .2s var(--spring); }
.daylist button:active { transform: scale(.98); }
.daylist .n { width: 30px; height: 30px; border-radius: 50%; background: var(--red); color: var(--on-red); display: grid; place-items: center; font-family: var(--serif); font-weight: 800; }
.daylist [data-vibe="future"] .n { background: var(--cyan); color: #04222a; }
.daylist .r { min-width: 0; font-size: 14.5px; font-weight: 600; }
.daylist .go { color: var(--ink-2); }

/* ---------- food passport ---------- */
.passport { display: flex; align-items: center; gap: 16px; margin: 6px auto 4px; max-width: 420px; padding: 12px 16px; border-radius: 16px; background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow); }
.ring { position: relative; width: 74px; height: 74px; flex: 0 0 74px; }
.ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
.ring circle { fill: none; stroke-width: 6; }
.ring .trk { stroke: var(--line); }
.ring .val { stroke: var(--red); stroke-linecap: round; stroke-dasharray: 100; transition: stroke-dashoffset .9s var(--ease); filter: drop-shadow(0 0 4px color-mix(in srgb, var(--red) 60%, transparent)); }
.ring b { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--serif); font-size: 17px; font-weight: 900; }
.ring b small { font-size: 10px; font-weight: 700; }
.passport .pt { min-width: 0; }
.passport .pt strong { display: block; font-family: var(--serif); font-size: 19px; }
.passport .pt span { font-size: 13px; color: var(--ink-2); }
.food-group { margin-top: 26px; position: relative; }
.food-group h3 { font-size: 21px; display: flex; align-items: baseline; gap: 10px; }
.food-group h3 small { font-family: var(--sans); font-size: 13px; color: var(--ink-2); font-weight: 700; }
.gdone { font-family: var(--sans); font-size: 12px; font-weight: 800; color: var(--foil-ink, #3a2705); background: var(--foil); padding: 2px 9px; border-radius: 99px; align-self: center; animation: popIn .6s var(--spring); }
.gdone[hidden] { display: none; }
@keyframes popIn { from { transform: scale(0); } to { transform: scale(1); } }
.dishes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 12px; }
.dish {
  position: relative; padding: 0; text-align: left; border: 1px solid var(--line); background: var(--card); border-radius: 12px; overflow: hidden;
  display: flex; flex-direction: column; min-width: 0; box-shadow: var(--shadow); min-height: 44px; width: 100%;
}
.dish .ph { border-radius: 0; aspect-ratio: 4 / 3; }
.dish .emo { aspect-ratio: 4 / 3; display: grid; place-items: center; font-size: 52px; background: linear-gradient(135deg, var(--card-2), var(--paper-2)); }
.dish .nm { padding: 8px 10px 10px; font-size: 14px; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
.dish .st {
  position: absolute; right: 8px; top: 8px; width: 70px; height: 70px; border-radius: 50%; display: grid; place-items: center; text-align: center;
  font-family: var(--serif); font-weight: 900; font-size: 13px; letter-spacing: .1em; color: var(--red); line-height: 1.1;
  border: 3px double var(--red); background: color-mix(in srgb, var(--card) 72%, transparent); transform: rotate(-14deg) scale(1.7); opacity: 0; pointer-events: none;
}
.dish .st::before { content: ""; position: absolute; inset: -18px; border-radius: 50%; opacity: 0; background:
  radial-gradient(circle 3px at 8% 40%, var(--red) 98%, #0000), radial-gradient(circle 2px at 93% 30%, var(--red) 98%, #0000),
  radial-gradient(circle 4px at 82% 90%, var(--red) 98%, #0000), radial-gradient(circle 2px at 18% 92%, var(--red) 98%, #0000),
  radial-gradient(circle 2.5px at 52% 2%, var(--red) 98%, #0000), radial-gradient(circle 1.6px at 98% 64%, var(--red) 98%, #0000),
  radial-gradient(circle 1.8px at 3% 72%, var(--red) 98%, #0000); }
.dish[aria-pressed="true"] { border-color: var(--red); }
.dish[aria-pressed="true"] .st { opacity: .95; transform: rotate(-14deg) scale(1); }
.dish[aria-pressed="true"] .st::before { opacity: .45; }
.dish[aria-pressed="true"] .ph, .dish[aria-pressed="true"] .emo { filter: saturate(.75) sepia(.12); }
.dish.thunk { animation: bump .45s ease-out; }
.dish.thunk .st { animation: inkstamp .7s cubic-bezier(.2, 1.3, .4, 1); }
.dish.thunk .st::before { animation: splat .7s ease-out; }
@keyframes inkstamp { 0% { transform: rotate(-40deg) scale(2.6); opacity: 0; } 45% { transform: rotate(-12deg) scale(.82); opacity: 1; } 70% { transform: rotate(-15deg) scale(1.08); } 100% { transform: rotate(-14deg) scale(1); opacity: .95; } }
@keyframes splat { 0% { opacity: 0; transform: scale(.3); } 45% { opacity: .9; transform: scale(1.18); } 100% { opacity: .45; transform: scale(1); } }
@keyframes bump { 0% { transform: translateY(0); } 40% { transform: translateY(4px) scale(.975); } 100% { transform: none; } }
.burst { position: fixed; z-index: 95; width: 0; height: 0; pointer-events: none; }
.burst span { position: absolute; left: 0; top: 0; font-size: 20px; line-height: 1; animation: pop 1.15s cubic-bezier(.1, .7, .3, 1) forwards; }
@keyframes pop { 0% { transform: translate3d(0, 0, 0) scale(.3) rotate(0); opacity: 1; } 100% { transform: translate3d(var(--dx), var(--dy), 0) scale(1.15) rotate(var(--r)); opacity: 0; } }

/* ---------- packing ---------- */
.subsec { margin-top: 38px; }
.subsec > h3 { font-size: 24px; margin-bottom: 4px; text-align: center; }
.pack { display: grid; gap: 8px; margin-top: 12px; }
.pack button { display: grid; grid-template-columns: 30px 1fr; gap: 12px; align-items: center; min-height: 48px; padding: 8px 12px; text-align: left; border: 1px solid var(--line); border-radius: 12px; background: var(--card); }
.pack .box { width: 28px; height: 28px; border: 2px dashed var(--ink-2); border-radius: 4px; display: grid; place-items: center; font-weight: 800; color: var(--red); font-size: 18px; transition: background .2s; }
.pack button[aria-pressed="true"] .box { border-style: solid; border-color: var(--red); background: color-mix(in srgb, var(--red) 10%, transparent); }
.pack button[aria-pressed="true"] .box::before { content: "✓"; }
.pack button[aria-pressed="true"] .tx { text-decoration: line-through; text-decoration-color: var(--red); color: var(--ink-2); }
.pack button.thunk .box { animation: inkstamp .5s cubic-bezier(.2, 1.4, .4, 1); }
.progress { display: flex; align-items: center; gap: 12px; margin: 10px 0 4px; }
.progress .bar { flex: 1; height: 12px; border-radius: 99px; background: var(--card-2); border: 1px solid var(--line); overflow: hidden; }
.progress .bar i { display: block; height: 100%; width: 0; background: var(--airmail); background-size: 40px 40px; transition: width .6s var(--ease); }
.progress .cnt { font-family: var(--serif); font-weight: 800; font-size: 16px; white-space: nowrap; }

/* ---------- info ---------- */
.cards { display: grid; gap: 10px; margin-top: 12px; }
.hl { display: flex; gap: 12px; align-items: center; padding: 12px 14px; border-radius: 12px; background: var(--card); border: 1px solid var(--line); font-weight: 600; }
.hl .ic { font-size: 26px; }
.two { display: grid; gap: 16px; margin-top: 18px; }
.panel { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; }
.panel h3 { font-size: 18px; margin-bottom: 8px; }
.panel li { display: flex; gap: 10px; padding: 7px 0; border-top: 1px dashed var(--line); font-size: 14.5px; }
.panel li:first-of-type { border-top: 0; }
.panel li .ic { flex: 0 0 24px; text-align: center; }
.panel.ex { background: var(--card-2); }
details.remarks { margin-top: 16px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; }
details.remarks summary { min-height: 52px; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; cursor: pointer; font-family: var(--serif); font-weight: 800; font-size: 18px; list-style: none; }
details.remarks summary::-webkit-details-marker { display: none; }
details.remarks summary::after { content: "＋"; font-size: 18px; color: var(--red); }
details.remarks[open] summary::after { content: "－"; }
details.remarks ol { padding: 0 16px 14px 36px; list-style: decimal; display: grid; gap: 8px; font-size: 14.5px; color: var(--ink-2); }
.links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; align-items: center; }
.lnk { display: inline-flex; align-items: center; gap: 5px; min-height: 44px; padding: 0 14px; border-radius: 99px; border: 1.5px solid var(--line); font-size: 13.5px; font-weight: 700; text-decoration: none; background: var(--card); }
.lnk:active { background: var(--paper-2); }
.contacts { display: grid; gap: 12px; margin-top: 12px; }
.contact { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; position: relative; overflow: hidden; }
.contact::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 6px; background: var(--airmail); }
.contact .cn { font-family: var(--serif); font-weight: 800; font-size: 19px; margin-top: 4px; }
.contact .cr { font-size: 13px; color: var(--ink-2); }
.contact .num { font-variant-numeric: tabular-nums; font-weight: 700; margin-top: 4px; }
.note-card { margin-top: 20px; padding: 14px 16px; border-radius: 14px; background: var(--cyan-bg); border: 1px solid color-mix(in srgb, var(--cyan) 40%, transparent); font-size: 14.5px; display: grid; gap: 8px; }
.addr { margin-top: 12px; font-size: 13px; color: var(--ink-2); }

/* ---------- footer ---------- */
.foot { margin-top: 56px; text-align: center; font-size: 13px; color: var(--ink-2); padding-bottom: 28px; }
.foot .airmail { margin-bottom: 20px; }
.foot p + p { margin-top: 3px; }
.foot-small { font-size: 12px; opacity: .8; margin-top: 10px; }

/* ---------- laptop ---------- */
@media (min-width: 700px) {
  .passes { grid-template-columns: 1fr 1fr; }
  .dishes { grid-template-columns: repeat(3, 1fr); }
  .two { grid-template-columns: 1fr 1fr; }
  .contacts, .cards { grid-template-columns: repeat(3, 1fr); }
  .cards.hls { grid-template-columns: 1fr 1fr; }
  .pack { grid-template-columns: 1fr 1fr; }
  .sheet { bottom: auto; top: 50%; left: 50%; right: auto; width: min(440px, 90vw); border-radius: 20px; border-bottom: 1px solid var(--line); transform: translate3d(-50%, -42%, 0) scale(.95); opacity: 0; transition: transform .4s var(--ease), opacity .3s; }
  .sheet-root.open .sheet { transform: translate3d(-50%, -50%, 0); opacity: 1; }
}
@media (min-width: 860px) {
  :root { --hdr: 64px; }
  body { padding-bottom: 0; }
  .tabbar { display: none; }
  .topnav { display: flex; gap: 4px; margin-left: auto; }
  .topnav a { min-height: 44px; display: inline-flex; align-items: center; padding: 0 14px; border-radius: 99px; text-decoration: none; font-weight: 700; font-size: 15px; color: var(--ink-2); transition: background .2s, color .2s; }
  .topnav a:hover { background: var(--paper-2); }
  .topnav a[aria-current="true"] { color: var(--on-red); background: var(--red); }
  .brand { margin-right: 0; }
  .topbar-in { gap: 24px; }
  .postmark::after { display: block; }
  .postmark { width: 112px; height: 112px; }
  .postmark b { font-size: 42px; }
  .cd { padding: 22px 28px; }
  .cd-title { font-size: 28px; }
  .fcard { min-width: 66px; font-size: 34px; padding: 11px 8px; }
  .seal { width: 96px; height: 96px; font-size: 46px; right: max(40px, calc(50% - 480px)); bottom: 90px; }
  .hero-vert { right: max(40px, calc(50% - 560px)); }
  .dishes { grid-template-columns: repeat(4, 1fr); }
  .day { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: start; }
  .day-left { position: sticky; top: calc(var(--hdr) + 92px); padding-bottom: 22px; }
  .day-media > .ph { aspect-ratio: 4 / 4.6; }
  .day-main { padding: 24px 24px 24px 8px; }
  .cards.hls { grid-template-columns: repeat(4, 1fr); }
  .hl { flex-direction: column; text-align: center; align-items: center; justify-content: center; min-height: 120px; }
  .chips { justify-content: center; }
  .sec-head h2 { font-size: 46px; }
}

/* ---------- reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; animation-delay: 0s !important; transition-duration: .001ms !important; scroll-behavior: auto !important; }
  .js .reveal { opacity: 1; transform: none; }
  .map-svg .mask-path { stroke-dashoffset: 0; }
  .map.in .route { animation: none; }
  .grain { display: none; }
  .hero > .ph img, .day-media > .ph img { transform: none !important; }
  .pulse { display: none; }
}
@media print { .tabbar, .topbar { display: none; } }
